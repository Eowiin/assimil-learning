{
  "version": 1,
  "language": "es",
  "phonemes": [
    {"id": "phon_01", "ipa": "/a/", "type": "voyelle", "graphie": "a", "exemple": "casa", "priorite_fr": "faible", "note": "Toujours ouverte, jamais nasalisée."},
    {"id": "phon_02", "ipa": "/e/", "type": "voyelle", "graphie": "e", "exemple": "perro", "priorite_fr": "moyenne", "note": "Son unique entre é et è, jamais muet en fin de mot."},
    {"id": "phon_03", "ipa": "/i/", "type": "voyelle", "graphie": "i, y", "exemple": "sí, rey", "priorite_fr": "faible", "note": "Pure et tendue."},
    {"id": "phon_04", "ipa": "/o/", "type": "voyelle", "graphie": "o", "exemple": "oso", "priorite_fr": "moyenne", "note": "Toujours ouverte/moyenne, jamais fermée comme dans 'eau'."},
    {"id": "phon_05", "ipa": "/u/", "type": "voyelle", "graphie": "u", "exemple": "luna", "priorite_fr": "moyenne", "note": "Correspond au 'ou' français, jamais 'u' français."},
    {"id": "phon_06", "ipa": "/ɾ/", "type": "consonne_vibrante", "graphie": "r (simple)", "exemple": "caro, pero", "priorite_fr": "haute", "note": "Battement simple de la pointe de la langue (comme un 'tt' rapide en anglais américain 'water')."},
    {"id": "phon_07", "ipa": "/r/", "type": "consonne_vibrante", "graphie": "rr, r- (initial)", "exemple": "perro, rojo", "priorite_fr": "critique", "note": "Roulé multiple (2-3 battements). Change le sens des mots (pero vs perro)."},
    {"id": "phon_08", "ipa": "/x/", "type": "consonne_fric", "graphie": "j, ge, gi", "exemple": "jardín, gente", "priorite_fr": "critique", "note": "Jota gutturale (racine de la langue contre le voile du palais)."},
    {"id": "phon_09", "ipa": "/θ/", "type": "consonne_fric", "graphie": "z, ce, ci", "exemple": "zapato, cielo", "priorite_fr": "haute", "note": "Interdentale (Espagne). Réalisée /s/ en Amérique Latine (seseo)."},
    {"id": "phon_10", "ipa": "/ɲ/", "type": "consonne_nasale", "graphie": "ñ", "exemple": "niño, año", "priorite_fr": "faible", "note": "Équivalent du 'gn' français dans 'montagne'."},
    {"id": "phon_11", "ipa": "/tʃ/", "type": "consonne_affriquee", "graphie": "ch", "exemple": "coche, mucho", "priorite_fr": "moyenne", "note": "Son 'tch' explosif, jamais 'ch' doux français."},
    {"id": "phon_12", "ipa": "/ʝ/", "type": "consonne_palatale", "graphie": "y, ll", "exemple": "yo, calle", "priorite_fr": "moyenne", "note": "Son 'y' appuyé (yeísmo). Réalisé /ʃ/ ou /ʒ/ en Argentine/Uruguay."},
    {"id": "phon_13", "ipa": "/b/", "type": "consonne_occlusive", "graphie": "b, v (initial)", "exemple": "burro, vino", "priorite_fr": "haute", "note": "Aucune distinction entre B et V en espagnol. Occlusif après pause ou M/N."},
    {"id": "phon_14", "ipa": "/β/", "type": "allophone", "graphie": "b, v (intervocalique)", "exemple": "saber, vivir", "priorite_fr": "haute", "note": "B doux sans fermer complètement les lèvres (ne jamais faire le 'v' français)."},
    {"id": "phon_15", "ipa": "/d/", "type": "consonne_occlusive", "graphie": "d (initial)", "exemple": "dar, donde", "priorite_fr": "faible", "note": "Dental (langue derrière les dents supérieures)."},
    {"id": "phon_16", "ipa": "/ð/", "type": "allophone", "graphie": "d (intervocalique/final)", "exemple": "nada, Madrid", "priorite_fr": "haute", "note": "D très doux (proche du 'th' anglais dans 'this'), souvent quasi muet en fin de mot."},
    {"id": "phon_17", "ipa": "/g/", "type": "consonne_occlusive", "graphie": "g (a,o,u), gu (e,i)", "exemple": "gato, guerra", "priorite_fr": "faible", "note": "Occlusif après pause ou N."},
    {"id": "phon_18", "ipa": "/ɣ/", "type": "allophone", "graphie": "g (intervocalique)", "exemple": "agua, lago", "priorite_fr": "moyenne", "note": "G adouci sans blocage complet de l'air."},
    {"id": "phon_19", "ipa": "/s/", "type": "consonne_fric", "graphie": "s", "exemple": "casa, sol", "priorite_fr": "haute", "note": "Toujours sourd ('ss'), jamais sonorisé en 'z' entre deux voyelles."},
    {"id": "phon_20", "ipa": "/p/", "type": "consonne_occlusive", "graphie": "p", "exemple": "padre", "priorite_fr": "faible", "note": "Non aspiré."},
    {"id": "phon_21", "ipa": "/t/", "type": "consonne_occlusive", "graphie": "t", "exemple": "taza", "priorite_fr": "faible", "note": "Dental, non aspiré."},
    {"id": "phon_22", "ipa": "/k/", "type": "consonne_occlusive", "graphie": "c (a,o,u), qu (e,i)", "exemple": "casa, queso", "priorite_fr": "faible", "note": "Non aspiré."},
    {"id": "phon_23", "ipa": "/f/", "type": "consonne_fric", "graphie": "f", "exemple": "fuego", "priorite_fr": "faible", "note": "Identique au français."},
    {"id": "phon_24", "ipa": "/l/", "type": "consonne_laterale", "graphie": "l", "exemple": "luna, sol", "priorite_fr": "faible", "note": "Toujours clair."},
    {"id": "phon_25", "ipa": "/m/", "type": "consonne_nasale", "graphie": "m", "exemple": "madre", "priorite_fr": "faible", "note": "Identique au français."},
    {"id": "phon_26", "ipa": "/n/", "type": "consonne_nasale", "graphie": "n", "exemple": "noche", "priorite_fr": "moyenne", "note": "Ne nasalise jamais la voyelle précédente (ex: 'pan' se prononce 'panne')."},
    {"id": "phon_27", "ipa": "prosodie_accent", "type": "regle_prosodique", "graphie": "á, é, í, ó, ú", "exemple": "hablo vs habló", "priorite_fr": "critique", "note": "L'accent tonique est distinctif. Sans accent écrit : avant-dernière syllabe (si finit par voyelle/n/s) ou dernière syllabe."},
    {"id": "phon_28", "ipa": "prosodie_sinalefa", "type": "regle_prosodique", "graphie": "liaison vocalique", "exemple": "mi_amigo, va_a_ir", "priorite_fr": "haute", "note": "Fusion des voyelles entre deux mots dans une même syllabe rythmique."}
  ]
}
